# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Collector state and its output. The 126 pair is the same hazard the
# `market_index.json` note below already names — ~5 MB of The Classic's
# market data, untracked in a public repository until this line existed.
tool/.collect_state.json
tool/.collect_state_126.json

# Playwright MCP scratch
.playwright-mcp/

# Generated by the collector — CI produces it on every run
web/market_index.json
web/market_index_126.json

# The version-chooser's door list, same reason: a build artifact, not a
# source file, regenerated fresh every CI run by `escreverVersoes`.
web/versoes.json

# Screenshots de sessão. A regra é ampla de propósito, e por isso toda pasta
# que publica imagem precisa da sua exceção aqui — `fechado/ticket.png` é a
# prova da página inteira e foi silenciosamente deixada de fora de um commit
# antes desta linha existir.
*.png
!assets/icons/**/*.png
!web/**/*.png
!fechado/**/*.png
# Uma pasta de assets guarda assets: um .png aqui é para ser publicado. A regra
# larga acima é para print de sessão, e já engoliu em silêncio duas imagens que
# alguém quis comitar.
!assets/images/**/*.png

# Cache local do wrangler — id da conta e artefatos de build do Worker
tool/cron/.wrangler/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
.superpowers/
